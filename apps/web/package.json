{
  "name": "@app-health/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build-tracker.mjs && node scripts/generate-readability.mjs && node scripts/generate-public-entrypoints.mjs && vite build && node scripts/prerender-landing.mjs && node scripts/check-readability.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "clean": "rimraf dist *.tsbuildinfo",
    "test:browser": "playwright test",
    "pretest": "node scripts/build-tracker.mjs --check",
    "predev": "node scripts/build-tracker.mjs"
  },
  "dependencies": {
    "@app-health/contracts": "workspace:*",
    "@saas-maker/ui": "github:sass-maker/ui-library#v0.1.20&path:/packages/ui",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "beasties": "0.3.5",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.3.3",
    "terser": "5.51.2",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
