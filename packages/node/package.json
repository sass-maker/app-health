{
  "name": "@saas-maker/app-health",
  "version": "0.3.0",
  "description": "Privacy-first endpoint health telemetry for Node.js, Hono, Express, and Cloudflare Pages Functions.",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js",
      "require": "./dist/hono.cjs"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "import": "./dist/pages.js",
      "require": "./dist/pages.cjs"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.js",
      "require": "./dist/viewer.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sass-maker/app-health.git",
    "directory": "packages/node"
  },
  "homepage": "https://health.sassmaker.com",
  "bugs": {
    "url": "https://github.com/sass-maker/app-health/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bench": "vitest run --testNamePattern benchmark",
    "build": "tsup src/index.ts src/express.ts src/hono.ts src/pages.ts src/web.ts src/viewer.ts --format esm,cjs --dts --clean --external express --external hono --external hono/route",
    "pack:verify": "pnpm run build && node ../../scripts/verify-node-package.mjs",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "express": "^4.19.2",
    "hono": "^4.12.34",
    "supertest": "^7.0.0",
    "tsup": "8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "express": ">=4.19.0 <6",
    "hono": ">=4.10.0 <5"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  }
}
